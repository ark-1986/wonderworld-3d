{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wonderworld-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "AdventureRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdventureRoom"] }
  ]
}
